// Mriya WM configuration.
//
// The format and the section names are deliberately the same as in niri, so an
// existing niri config can be copied over: unimplemented sections are ignored
// with a debug message instead of breaking the parse.
//
// Copy this file to $XDG_CONFIG_HOME/mriya/config.kdl (usually
// ~/.config/mriya/config.kdl) or point at it with `mriya-wm --config <path>`.
//
// KDL reference: https://kdl.dev

// Cursor theme and size. Falls back to XCURSOR_THEME / XCURSOR_SIZE, then to
// "default" and 24.
cursor {
    xcursor-theme "Horse-Red"
    xcursor-size 38

    // Not implemented yet, ignored:
    // hide-when-typing
}

// Server-side window decorations (xfwm4 themes).
decorations {
    // Any theme name from `mriya-wm --list-themes`; images come from
    // ~/.themes, ~/.local/share/themes and $XDG_DATA_DIRS/themes.
    theme "Default"

    // The title font is an xfwm4 setting, not a part of the theme.
    title-font "Sans Bold 9"

    // Overrides the theme's `button_layout`, e.g. "O|SHMC".
    // button-layout "O|SHMC"

    // Drop shadows: `false` turns them off completely, `shadow-opacity`
    // overrides the theme's `shadow_opacity` (0..100).
    shadows true
    // shadow-opacity 30

    // Символические цвета XPM (`c #D8D8D8 s active_color_2`): в xfwm4 их
    // подставляет GTK-тема, которой у Mriya нет. "theme" (по умолчанию) —
    // фон/границы/кнопки берут цвет, нарисованный в самом XPM, а акцентное
    // семейство `_1` (тело заголовка) — из пресета Mriya; "preset" — вся
    // палитра из пресета. Переключи, если тема выглядит чужой.
    // palette-mode "theme"

    // Palette of the 24 symbols xfwm4 themes refer to instead of literal
    // colours. Only the ones a theme uses need to be set.
    palette {
        // active_color_2 "#336699"
        // active_text_color "#ffffff"
    }
}

// Масштаб: по умолчанию из DPI панели, переопределяется для всех или по имени.
// output { scale 1.5 }
// output "eDP-1" { scale 1.75 }

input {
    keyboard {
        xkb {
            layout "us,ru"
            // variant ""
            // model ""
            // rules ""
            options "grp:caps_toggle"
        }
        repeat-delay 350
        repeat-rate 17

        // Not implemented yet (niri: keyboard layout switches per window):
        // track-layout "window"
    }

    // Настройки устройств применяет libinput, то есть только в самостоятельной
    // сессии; во вложенной они игнорируются (наследуется конфиг хоста).
    // touchpad { tap true; natural-scroll true; dwt true; accel-speed 0.2;
    //            scroll-method "two-finger"; left-handed false; }
    // mouse { natural-scroll false; accel-speed 0.0; left-handed false; }
}

// Environment variables for the session and for every client started by Mriya.
environment {
    // XDG_MENU_PREFIX "arch-"
    // GTK_THEME "Ambiance:light"
}

// Commands started once the compositor is up. A single string is run through
// `sh -c`, several arguments are executed directly (like in niri).
spawn-at-startup "foot"

// Key bindings. Chords are `Modifier+Modifier+Key`, the key name is an XKB
// symbol name. `Mod` is `Alt` while Mriya runs nested inside another session,
// and `Super` when it owns the input devices.
binds {
    Mod+q { close-window; }
    Mod+Escape { quit; }

    // `spawn-terminal` starts $TERMINAL, or the first of
    // foot/ghostty/kitty/wezterm/alacritty/xfce4-terminal/xterm in PATH.
    Mod+Return { spawn-terminal; }

    // Launchers like fuzzel/rofi need wlr-layer-shell, which Mriya does not
    // implement yet; a normal window works in the meantime.
    Mod+R { spawn "xfce4-appfinder"; }
    Mod+Shift+Return { spawn-sh "foot -e htop"; }

    // Toggle the focused window between floating, maximized and fullscreen.
    Mod+m { maximize-window; }
    Mod+f { fullscreen-window; }

    // Воркспейсы 1..9 (как в niri): переключение и перенос окна. Без этих биндов
    // воркспейсы есть, но попасть на них можно только мышью через панель.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-window-to-workspace-up; }
    Mod+Shift+Page_Down { move-window-to-workspace-down; }

    // Media keys work the same way as in niri.
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
}

// Per-window rules, evaluated whenever a window's app-id or title changes; the
// last matching rule wins. Decorations are normally detected automatically (a
// client that draws its own sets an inset window geometry), so rules here are an
// escape hatch for exceptions:
window-rule {
    match app-id=r#"^org\.gnome\."#
    decorations "client-side"
}

// Not implemented yet, ignored for now:
// layout { gaps 4; }
// output "DP-1" { scale 1; }
// prefer-no-csd
// animations { off; }

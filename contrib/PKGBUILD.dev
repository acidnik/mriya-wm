# dev-вариант: собирает пакет из этого рабочего дерева, а не из GitHub.
#
#   git pull && cd contrib && makepkg -si -p PKGBUILD.dev
#
# Для AUR по-прежнему используется contrib/PKGBUILD (источник с пином на коммит).

pkgname=mriya-wm
# Версия = версия из Cargo.toml + номер и хеш коммита (+ .dirty, если в дереве
# есть незакоммиченные правки). Так `makepkg -si` каждый раз видит новую версию
# и пересобирает: с неизменным pkgver он просто переиспользует готовый пакет.
_git_dir="$startdir/.."
_crate_ver=$(sed -n 's/^version = "\(.*\)"/\1/p' "$_git_dir/Cargo.toml" | head -1)
_git_count=$(git -C "$_git_dir" rev-list --count HEAD 2>/dev/null || echo 0)
_git_rev=$(git -C "$_git_dir" rev-parse --short HEAD 2>/dev/null || echo nogit)
# Только правки уже отслеживаемых файлов: `makepkg` запускает git с
# GIT_CONFIG_GLOBAL=/dev/null, поэтому неотслеживаемое (и обычно игнорируемое
# глобально) всплывает и делало бы версию вечно «.dirty».
if [ -n "$(git -C "$_git_dir" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    _git_dirty=".dirty"
else
    _git_dirty=""
fi
pkgver="${_crate_ver}.r${_git_count}.g${_git_rev}${_git_dirty}"
pkgrel=1
pkgdesc="Stacking Wayland window manager with xfwm4 window decorations"
arch=('x86_64')
url="https://github.com/acidnik/mriya-wm"
license=('MIT')
depends=('libxkbcommon' 'mesa' 'wayland' 'fontconfig' 'freetype2')
optdepends=('waybar: the panel the default config starts'
            'xcursor-themes: cursor themes for the compositor to load')
makedepends=('cargo' 'git')
source=()
sha256sums=()

build() {
    cd "$startdir/.."
    # Свой target/ и CARGO_HOME, как у makepkg принято.
    export CARGO_TARGET_DIR="$startdir/../target"
    cargo build --release --locked
}

check() {
    cd "$startdir/.."
    ./target/release/mriya-wm --help >/dev/null
}

package() {
    cd "$startdir/.."

    install -Dm755 target/release/mriya-wm "$pkgdir/usr/bin/mriya-wm"
    install -Dm755 dist/mriya-session "$pkgdir/usr/bin/mriya-session"
    install -Dm644 dist/mriya.desktop \
        "$pkgdir/usr/share/wayland-sessions/mriya.desktop"
    install -Dm644 dist/config.kdl "$pkgdir/usr/share/mriya/config.kdl"
    install -Dm644 docs/example-config.kdl \
        "$pkgdir/usr/share/mriya/example-config.kdl"
    install -Dm644 dist/waybar/config.jsonc \
        "$pkgdir/usr/share/mriya/waybar/config.jsonc"
    install -Dm644 dist/waybar/style.css \
        "$pkgdir/usr/share/mriya/waybar/style.css"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
